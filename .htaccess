# ============================================================
#  Generación Tech · configuración para hostings Apache
#  (Hostinger, DonWeb, cPanel, etc.). En Netlify se usa netlify.toml.
# ============================================================
Options -Indexes
ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

# Bloquear archivos internos
RedirectMatch 404 ^/(_respaldo|\.claude)(/.*)?$
RedirectMatch 404 ^/(serve\.js|netlify\.toml|LEEME-PUBLICAR\.md)$

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-xMEne5xSNlgeOligOATNEvyFpyN5H3HG/E/qDyG8S5Y='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formsubmit.co https://formspree.io; form-action 'self' https://formsubmit.co https://formspree.io; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  <FilesMatch "\.(woff2|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/manifest+json application/xml
</IfModule>
